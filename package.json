{
  "name": "aittadb",
  "version": "0.1.0",
  "description": "A hosted application backend for third-party apps, with ChatGPT sign-in, AittaDB-issued OAuth and OpenID Connect sessions, isolated D1 records, and R2 file storage.",
  "private": true,
  "author": "Jaakko Heusala <jheusala@iki.fi>",
  "license": "FSL-1.1-MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "openapi:check": "node --import tsx scripts/check-openapi.ts",
    "swagger:sync": "node --import tsx scripts/sync-swagger-ui.ts",
    "swagger:check": "node --import tsx scripts/sync-swagger-ui.ts --check",
    "db:check": "node --import tsx scripts/check-migrations.ts",
    "agents:check": "node --import tsx scripts/check-agents-size.ts",
    "audit:high": "npm audit --audit-level=high",
    "keys:generate": "node --import tsx scripts/generate-keypair.ts",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run openapi:check && npm run swagger:check && npm run db:check && npm run agents:check && npm run audit:high && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "swagger-ui-dist": "5.32.12",
    "vinext": "1.0.0-beta.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.7.4",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module"
}
