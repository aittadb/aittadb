# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.tfstate
*.tfstate.*
*.tfvars
!*.example.tfvars

# generated and tool-specific local credentials
/.secrets/
/.direnv/
/.envrc
/.netrc
/.npmrc
/.pypirc
/admin-subjects*
/client-secret*
/credentials.json
/jwt-signing-key*.json
/secrets.json
/secrets.yaml
/secrets.yml
/service-account*.json
/service_account*.json
/id_dsa
/id_ecdsa
/id_ed25519
/id_rsa

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local runtime environment; only inert templates belong in Git
.env*
!.env.example
!.env.sample
!.env.template
.dev.vars*
!.dev.vars.example
!.dev.vars.sample
!.dev.vars.template
*.tsbuildinfo

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# checkout-local Sites project metadata
/.openai/hosting.json
