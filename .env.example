# AittaDB inert configuration template. Copy it to ignored local configuration;
# never put a real secret or deployment-specific private value in this file.

# Public issuer URL for this deployment, for example:
# ISSUER_URL=https://your-site.example
ISSUER_URL=

# ES256 signing key material. Generate a unique ignored mode-0600 file with
# npm run --silent keys:generate; validate/rotate it using docs/key-rotation.md. No
# supported command prints the private JWK.
JWT_KEY_ID=
JWT_PRIVATE_JWK=

# Comma-separated canonical local UUIDv4 subjects allowed to administer this
# deployment. Sign in at /session to obtain each deployment-local subject.
# An empty list disables administration. Do not use email addresses or names.
ADMIN_SUBJECTS=

# Optional public Privacy Policy identity and contact fields. Set only values the
# deployment operator intends to publish at /privacy. Explicit values take
# precedence. If required controller/contact data is missing, AittaDB may use
# only the stored email and optional display name of the first ADMIN_SUBJECTS
# user; it never publishes that user's UUID or the administrator list.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_IDENTIFIER=
PRIVACY_CONTACT_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_CONTACT_PHONE=
PRIVACY_CONTACT_ADDRESS=

# Bind D1 as DB and R2 as BUCKET in Sites hosting metadata.

# Optional secure defaults.
ACCESS_TOKEN_TTL_SECONDS=600
AUTH_CODE_TTL_SECONDS=300
DEVICE_CODE_TTL_SECONDS=900
DEVICE_POLL_INTERVAL_SECONDS=5
REFRESH_TOKEN_TTL_SECONDS=2592000
ALLOWED_CORS_ORIGINS=

# Independently deployable server features. Malformed values fail startup.
# Records, Files, and Statistics default on; OAuth Apps and Events default off.
# Disabling Records removes its discovery controls and returns 503 before D1 use.
FEATURE_RECORDS_ENABLED=true
# Disabling Files removes its discovery controls and returns 503 before D1/R2 use.
FEATURE_FILES_ENABLED=true
# Set false to omit and disable the public aggregate identity count.
FEATURE_STATISTICS_ENABLED=true
# When false, external OAuth/OIDC operations and UserInfo are unavailable.
# Discovery retains only issuer/JWKS verification metadata; JWKS stays public.
FEATURE_OAUTH_APPS_ENABLED=false
# Enables immutable event publication, reads, and bounded delivery.
FEATURE_EVENTS_ENABLED=false
# New events expire after this many seconds; allowed range is 1 to 31536000.
EVENT_RETENTION_SECONDS=604800

# Independent AittaDB event ceilings; these are not Sites capacity claims.
EVENTS_GLOBAL_MAX_ITEMS=10000
EVENTS_GLOBAL_MAX_BYTES=268435456
EVENTS_USER_MAX_ITEMS=1000
EVENTS_USER_MAX_BYTES=33554432
EVENTS_NAMESPACE_MAX_ITEMS=500
EVENTS_NAMESPACE_MAX_BYTES=16777216
EVENTS_DEFAULT_PAGE_SIZE=50
EVENTS_MAX_PAGE_SIZE=100
EVENTS_READ_RATE_LIMIT=120
# Maximum accepted publications per user/client namespace in one minute.
EVENTS_PUBLISH_RATE_LIMIT=30
# Long polls require events.read plus events.subscribe and an opaque cursor.
EVENTS_SUBSCRIBE_RATE_LIMIT=30
# Worker-safe wait and repository-read ceilings; hard maxima are 30 and 31.
EVENTS_MAX_WAIT_SECONDS=25
EVENTS_MAX_WAIT_READS=26

# Private Worker-log maintenance evidence. Strictly parsed and disabled by
# default; it emits only fixed cleanup categories, bounded counts, and limits.
MAINTENANCE_CLEANUP_TELEMETRY_ENABLED=false

# AittaDB-enforced storage safety ceilings. These are not Sites capacity claims.
STORAGE_WRITES_ENABLED=true
STORAGE_GLOBAL_MAX_ITEMS=10000
STORAGE_GLOBAL_MAX_BYTES=1073741824
STORAGE_USER_MAX_ITEMS=1000
STORAGE_USER_MAX_BYTES=104857600
STORAGE_NAMESPACE_MAX_ITEMS=500
STORAGE_NAMESPACE_MAX_BYTES=52428800
STORAGE_DEFAULT_PAGE_SIZE=50
STORAGE_MAX_PAGE_SIZE=100
STORAGE_READ_RATE_LIMIT=120
STORAGE_WRITE_RATE_LIMIT=30
# Durable atomic-transaction replay window. Receipts expire after this many
# seconds and are removed in bounded maintenance batches; allowed range 60-604800.
BOUNDED_RECORD_RECEIPT_RETENTION_SECONDS=86400
# Independent ordinary transaction-receipt ceilings. Delete-only transactions
# may use a separate finite server-derived reserve tied to storage item limits.
BOUNDED_RECORD_RECEIPT_GLOBAL_MAX_ITEMS=10000
BOUNDED_RECORD_RECEIPT_GLOBAL_MAX_BYTES=1073741824
BOUNDED_RECORD_RECEIPT_USER_MAX_ITEMS=1000
BOUNDED_RECORD_RECEIPT_USER_MAX_BYTES=104857600
BOUNDED_RECORD_RECEIPT_NAMESPACE_MAX_ITEMS=500
BOUNDED_RECORD_RECEIPT_NAMESPACE_MAX_BYTES=52428800
NODE_ENV=production
