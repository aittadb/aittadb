# AittaDB inert configuration template. Copy it to ignored local configuration;
# never put a real secret or deployment-specific private value in this file.

# Public issuer URL for this deployment, for example:
# ISSUER_URL=https://your-site.example
ISSUER_URL=

# ES256 signing key material. Generate locally with:
# npm run keys:generate
JWT_KEY_ID=
JWT_PRIVATE_JWK=

# Comma-separated canonical local UUIDv4 subjects allowed to administer this
# deployment. Sign in at /session to obtain each deployment-local subject.
# An empty list disables administration. Do not use email addresses or names.
ADMIN_SUBJECTS=

# Optional public Privacy Policy identity and contact fields. Set only values the
# deployment operator intends to publish at /privacy. Explicit values take
# precedence. If required controller/contact data is missing, AittaDB may use
# only the stored email and optional display name of the first ADMIN_SUBJECTS
# user; it never publishes that user's UUID or the administrator list.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_IDENTIFIER=
PRIVACY_CONTACT_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_CONTACT_PHONE=
PRIVACY_CONTACT_ADDRESS=

# Bind D1 as DB and R2 as BUCKET in Sites hosting metadata.

# Optional secure defaults.
ACCESS_TOKEN_TTL_SECONDS=600
AUTH_CODE_TTL_SECONDS=300
DEVICE_CODE_TTL_SECONDS=900
DEVICE_POLL_INTERVAL_SECONDS=5
REFRESH_TOKEN_TTL_SECONDS=2592000
ALLOWED_CORS_ORIGINS=

# Independently deployable server features. Malformed values fail startup.
# Records, Files, and Statistics default on; downstream OAuth Apps default off.
# Disabling Records removes its discovery controls and returns 503 before D1 use.
FEATURE_RECORDS_ENABLED=true
# Disabling Files removes its discovery controls and returns 503 before D1/R2 use.
FEATURE_FILES_ENABLED=true
# Set false to omit and disable the public aggregate identity count.
FEATURE_STATISTICS_ENABLED=true
# When false, external OAuth/OIDC operations and UserInfo are unavailable.
# Discovery retains only issuer/JWKS verification metadata; JWKS stays public.
FEATURE_OAUTH_APPS_ENABLED=false

# AittaDB-enforced storage safety ceilings. These are not Sites capacity claims.
STORAGE_WRITES_ENABLED=true
STORAGE_GLOBAL_MAX_ITEMS=10000
STORAGE_GLOBAL_MAX_BYTES=1073741824
STORAGE_USER_MAX_ITEMS=1000
STORAGE_USER_MAX_BYTES=104857600
STORAGE_NAMESPACE_MAX_ITEMS=500
STORAGE_NAMESPACE_MAX_BYTES=52428800
STORAGE_DEFAULT_PAGE_SIZE=50
STORAGE_MAX_PAGE_SIZE=100
STORAGE_READ_RATE_LIMIT=120
STORAGE_WRITE_RATE_LIMIT=30
NODE_ENV=production
