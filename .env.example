# AittaDB configuration. Do not put real secrets in this file.

# Public issuer URL for this deployment, for example:
# ISSUER_URL=https://your-site.example
ISSUER_URL=

# ES256 signing key material. Generate locally with:
# npm run keys:generate
JWT_KEY_ID=
JWT_PRIVATE_JWK=

# Comma-separated canonical local UUIDv4 subjects allowed to administer this
# deployment. Sign in at /session to obtain each deployment-local subject.
# An empty list disables administration. Do not use email addresses or names.
ADMIN_SUBJECTS=

# Bind D1 as DB and R2 as BUCKET in Sites hosting metadata.

# Optional secure defaults.
ACCESS_TOKEN_TTL_SECONDS=600
AUTH_CODE_TTL_SECONDS=300
DEVICE_CODE_TTL_SECONDS=900
DEVICE_POLL_INTERVAL_SECONDS=5
REFRESH_TOKEN_TTL_SECONDS=2592000
ALLOWED_CORS_ORIGINS=

# AittaDB-enforced storage safety ceilings. These are not Sites capacity claims.
STORAGE_WRITES_ENABLED=true
STORAGE_GLOBAL_MAX_ITEMS=10000
STORAGE_GLOBAL_MAX_BYTES=1073741824
STORAGE_USER_MAX_ITEMS=1000
STORAGE_USER_MAX_BYTES=104857600
STORAGE_NAMESPACE_MAX_ITEMS=500
STORAGE_NAMESPACE_MAX_BYTES=52428800
STORAGE_DEFAULT_PAGE_SIZE=50
STORAGE_MAX_PAGE_SIZE=100
STORAGE_READ_RATE_LIMIT=120
STORAGE_WRITE_RATE_LIMIT=30
NODE_ENV=production
